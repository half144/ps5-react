+/*----------------------------------------------------------------------------------------------------------------------
+ - Scroll layer
+ *
+ * Scroll by copy still rasterizes the strip a scroll exposes, on the scroll frame. With a backend whose host can
+ * keep a second image (layer_resize), one ScrollView's content is painted there instead, unscrolled: a descendant's
+ * layer position is its screen position without that ScrollView's offset, which node_ancestor_scroll and
+ * render_node_content leave out. The host shows the layer's visible window over the framebuffer, so a scroll
+ * changes which window it shows and repaints nothing. What makes the composite exact:
+ *   - every rect painted into the layer starts with the color the ScrollView and its ancestors paint behind
+ *     the viewport, which must be one opaque color with nothing else of theirs there;
+ *   - nothing outside the ScrollView's content paints into the viewport (an overlay ends the layer);
+ *   - the damage pre-pass measures layer nodes in layer space against their own set, so a change repaints
+ *     its layer rects exactly as it would its screen rects.
+ * The layer is tracked in bands of ER_LAYER_BAND rows. A commit paints the bands the viewport shows that are
+ * not current; er_scroll_layer_prefetch() paints the rest when the host has time. Each region is painted from
+ * scratch inside its own clip, so the backend stages one region at a time and the host keeps the layer.
+ ---------------------------------------------------------------------------------------------------------------------*/
+
+/**
+ * @brief Marks a node's descendants as layer nodes.
+ *
+ * @param[in]  n      Node whose descendants to mark (not the node itself).
+ * @param[out] modal  Set when a Modal is among them.
+ */
+static void layer_mark_subtree(const ERNode* n, bool* modal)
+{
+    for (uint16_t c = n->first_child_tag; c != ER_INVALID_TAG;)
+    {
+        ERNode* ch = er_get_node(c);
+        if (!ch)
+            break;
+        s_in_layer[c] = true;
+        if (ch->type == ER_NODE_MODAL)
+            *modal = true;
+        layer_mark_subtree(ch, modal);
+        c = ch->next_sibling_tag;
+    }
+}
+
+/** @brief Whether a node paints anything of its own, as opposed to only holding children. */
+static bool node_paints_self(const ERNode* n)
+{
+    if (n->type != ER_NODE_VIEW && n->type != ER_NODE_SCROLL_VIEW && n->type != ER_NODE_PRESSABLE
+        && n->type != ER_NODE_FLAT_LIST)
+        return true;
+    const ERViewProps* vp = &n->props.view;
+#if ERUI_GRADIENT
+    if (vp->gradient_type != ER_GRADIENT_NONE && vp->gradient_stop_count >= 2U)
+        return true;
+#endif
+    return (vp->background_color >> 24) != 0U || vp->border_width > 0 || vp->border_left_width > 0
+           || vp->border_top_width > 0 || vp->border_right_width > 0 || vp->border_bottom_width > 0
+           || vp->shadow_opacity > 0.0f || vp->elevation != 0U;
+}
+
+/**
+ * @brief Whether a ScrollView can be layered, and where.
+ *
+ * Leaves s_in_layer holding its descendants.
+ *
+ * @param[in]  s         ScrollView to test.
+ * @param[out] rect      Layer bounds in layer space.
+ * @param[out] view      Screen rect the layer would be shown in.
+ * @param[out] underlay  Opaque color painted behind the viewport.
+ *
+ * @return true when every condition of the layer holds for it.
+ */
+static bool layer_candidate(ERNode* s, ERRect* rect, ERRect* view, uint32_t* underlay)
+{
+    if ((s->type != ER_NODE_SCROLL_VIEW && s->type != ER_NODE_FLAT_LIST) || s->subtree_hidden)
+        return false;
+    if (s->scroll_content_h <= s->computed.h || s->scroll_content_w > s->computed.w || (int)s->scroll_offset_x != 0)
+        return false; /* only vertical scrolling pays for a layer */
+    const ERNode* root = er_get_node(s_root_tag);
+    if (!root || s_display_buffer_count != 1 || s_kbd_avoid_y != 0 || er_keyboard_active())
+        return false;
+    for (const ERNode* a = er_get_node(s->parent_tag); a; a = er_get_node(a->parent_tag))
+        if (a->type == ER_NODE_SCROLL_VIEW || a->type == ER_NODE_FLAT_LIST)
+            return false;
+    int sx, sy, sw, sh;
+    if (s->has_transform || !node_screen_rect(s, &sx, &sy, &sw, &sh))
+        return false;
+    const int h = s->scroll_content_h > sh ? s->scroll_content_h : sh;
+    if (sy < -ER_PAINT_RECT_MAX || sy + h > ER_PAINT_RECT_MAX || h / ER_LAYER_BAND >= ER_LAYER_BANDS)
+        return false;
+    int vx = sx, vy = sy, vw = sw, vh = sh;
+    clip_rect_to_clippers(s, &vx, &vy, &vw, &vh);
+    if (!rect_intersect(&vx, &vy, &vw, &vh, root->computed.x, root->computed.y, root->computed.w, root->computed.h)
+        || 4L * vw * vh < (long)root->computed.w * root->computed.h)
+        return false;
+
+    bool color_found = false;
+    for (const ERNode* a = s; a; a = er_get_node(a->parent_tag))
+    {
+        if (a->has_transform || !paints_uniformly_over(a, vx, vy, vw, vh))
+            return false;
+        const uint32_t bg = a->props.view.background_color;
+        if (!color_found && (bg >> 24) != 0U)
+        {
+            if ((bg >> 24) != 0xFFU)
+                return false;
+            *underlay = bg;
+            color_found = true;
+        }
+    }
+    if (!color_found)
+        return false;
+
+    memset(s_in_layer, 0, sizeof(s_in_layer));
+    bool modal = false;
+    layer_mark_subtree(s, &modal);
+    if (modal)
+        return false;
+
+    /* Foreign paint: anything else that painted, or is about to paint, into the viewport. */
+    for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES; tag++)
+    {
+        ERNode* n = er_get_node(tag);
+        if (!n || n->subtree_hidden || s_in_layer[tag] || !node_paints_self(n))
+            continue;
+        bool chain = false;
+        for (const ERNode* a = s; a && !chain; a = er_get_node(a->parent_tag))
+            chain = (a == n);
+        if (chain)
+            continue;
+        int fx, fy, fw, fh;
+        if (n->has_last_paint)
+        {
+            fx = (int)n->last_paint_rect.x;
+            fy = (int)n->last_paint_rect.y;
+            fw = (int)n->last_paint_rect.w;
+            fh = (int)n->last_paint_rect.h;
+            int cx = fx, cy = fy, cw = fw, ch = fh;
+            if (rect_intersect(&cx, &cy, &cw, &ch, vx, vy, vw, vh))
+            {
+                clip_rect_to_clippers(n, &fx, &fy, &fw, &fh);
+                if (rect_intersect(&fx, &fy, &fw, &fh, vx, vy, vw, vh))
+                    return false;
+            }
+        }
+        if (node_screen_rect(n, &fx, &fy, &fw, &fh))
+        {
+            expand_for_arc(n, &fx, &fy, &fw, &fh);
+#if ERUI_SHADOWS
+            expand_for_shadow(n, &fx, &fy, &fw, &fh);
+#endif
+        }
+        else
+        {
+            NodeTransformDamage td = {0};
+            if (!node_transform_damage(n, &td))
+                return false;
+            fx = td.fx;
+            fy = td.fy;
+            fw = td.fw;
+            fh = td.fh;
+        }
+        int cx = fx, cy = fy, cw = fw, ch = fh;
+        if (rect_intersect(&cx, &cy, &cw, &ch, vx, vy, vw, vh))
+        {
+            clip_rect_to_clippers(n, &fx, &fy, &fw, &fh);
+            if (rect_intersect(&fx, &fy, &fw, &fh, vx, vy, vw, vh))
+                return false;
+        }
+    }
+
+    rect->x = sx;
+    rect->y = sy;
+    rect->w = sw;
+    rect->h = h;
+    view->x = vx;
+    view->y = vy;
+    view->w = vw;
+    view->h = vh;
+    return true;
+}
+
+/** @brief Number of bands the layer has. */
+static int layer_band_count(void)
+{
+    return (s_layer_rect.h + ER_LAYER_BAND - 1) / ER_LAYER_BAND;
+}
+
+/**
+ * @brief Tells the backend the layer's bounds (s_layer_rect).
+ *
+ * @param[out] kept  Whether the rows the layer already had are still there.
+ *
+ * @return false when the backend cannot hold a layer that size.
+ */
+static bool layer_resize(bool* kept)
+{
+    const EmbeddedRenderBackend* b = er_backend();
+    return b->layer_resize(s_layer_rect.x, s_layer_rect.y, s_layer_rect.w, s_layer_rect.h, kept, b->ctx);
+}
