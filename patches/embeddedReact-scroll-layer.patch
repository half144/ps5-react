+/** @brief The pixel a blit at (x, y) writes, or NULL when it falls outside the current target. */
+static uint32_t* target(TestCtx* t, int x, int y)
+{
+    if (t->in_layer)
+    {
+        x -= t->sx;
+        y -= t->sy;
+        return (x >= 0 && y >= 0 && x < t->sw && y < t->sh) ? &t->staging[y * t->sw + x] : NULL;
+    }
+    return (x >= 0 && y >= 0 && x < FB_W && y < FB_H) ? &t->fb[y * FB_W + x] : NULL;
+}
+
+/** @brief Backend fill_rect: writes or source-over blends a straight-alpha colour; counts painted pixels. */
+static void fill_cb(uint32_t argb, int x, int y, int w, int h, void* ctx)
+{
+    TestCtx* t = ctx;
