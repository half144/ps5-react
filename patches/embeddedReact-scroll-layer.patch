+#define FB_W 160
+#define FB_H 160
+#define ROWS 80
+#define LAYER_MAX (160 * 1024)
+
+typedef struct
+{
+    uint32_t fb[FB_W * FB_H];
+    uint32_t layer[LAYER_MAX];       /* what a host keeps on the GPU */
+    uint32_t staging[FB_W * 128];    /* the region being painted */
+    int lw, lh, lx, ly;              /* layer size and the engine coordinates of its top-left */
+    int sx, sy, sw, sh;              /* region being painted, engine coordinates */
+    bool in_layer;                   /* between layer_begin and layer_end */
+    long painted_px;                 /* pixels written by fill/copy/blend since the last reset */
+} TestCtx;
+
+static TestCtx g_ctx;
+static EmbeddedRenderBackend g_be;
+static int g_failures = 0;
