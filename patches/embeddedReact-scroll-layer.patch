+/*
+ * Scroll layer: with a backend that provides layer_begin, a page ScrollView's content paints into a separate
+ * buffer and a scroll repaints nothing. Every check composites the framebuffer and the layer the way a host
+ * does (er_scroll_layer_get) and compares the result with a full repaint of the same scene by a backend
+ * without a layer, pixel for pixel.
+ */
+
+#include "er_scene.h"
+#include "native_renderer.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
