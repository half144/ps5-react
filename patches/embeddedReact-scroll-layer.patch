+    {
+        const ERRect* v = &s_layer_removed.r[ri];
+        if (v->y < wy1 && v->y + v->h > wy0)
+            add_damage(dmg, v->x, v->y, v->w, v->h, lx0, ly0, lx1, ly1);
+        else
+            layer_invalidate(v->y, v->h);
+    }
+    for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES; tag++)
+    {
