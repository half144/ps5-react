+            else if (a != 0U)
+            {
+                uint32_t out = 0xFF000000U;
+                for (int sh = 0; sh < 24; sh += 8)
+                {
+                    const uint32_t s = (argb >> sh) & 0xFFU, dd = (*d >> sh) & 0xFFU;
+                    out |= ((s * a + dd * (255U - a)) / 255U) << sh;
+                }
+                *d = out;
+            }
+            t->painted_px++;
+        }
+}
+
+/** @brief Backend copy_rect: writes every non-transparent source pixel; counts painted pixels. */
+static void copy_cb(const void* src, int stride, int x, int y, int w, int h, void* ctx)
+{
+    TestCtx* t = ctx;
+    for (int row = 0; row < h; row++)
+        for (int col = 0; col < w; col++)
+        {
+            const uint32_t p = ((const uint32_t*)((const uint8_t*)src + (size_t)row * stride))[col];
+            uint32_t* d = target(t, x + col, y + row);
+            if (d && (p >> 24) != 0U)
+                *d = p;
+            t->painted_px++;
+        }
+}
+
+/** @brief Backend blend_rect: the same as copy_cb (the scene's translucent sources are fills). */
+static void blend_cb(const void* src, int stride, uint8_t alpha, int x, int y, int w, int h, void* ctx)
+{
+    (void)alpha;
+    copy_cb(src, stride, x, y, w, h, ctx);
+}
+
+/** @brief Backend layer_resize: keeps the rows when only the height changes. */
+static bool layer_resize_cb(int x0, int y0, int w, int h, bool* kept, void* ctx)
+{
+    TestCtx* t = ctx;
+    if ((long)w * h > LAYER_MAX)
+        return false;
+    *kept = w == t->lw && x0 == t->lx && y0 == t->ly;
+    if (!*kept)
+        memset(t->layer, 0x5A, sizeof(t->layer)); /* garbage: anything shown before it is painted fails */
+    t->lw = w;
+    t->lh = h;
+    t->lx = x0;
+    t->ly = y0;
+    return true;
+}
+
+/** @brief Backend layer_begin: a staging buffer full of garbage, so a pixel the engine skips shows up. */
+static bool layer_begin_cb(int x, int y, int w, int h, void* ctx)
+{
+    TestCtx* t = ctx;
+    if (w > FB_W || h > 128)
+        return false;
+    memset(t->staging, 0x3C, sizeof(t->staging));
+    t->sx = x;
+    t->sy = y;
+    t->sw = w;
+    t->sh = h;
+    t->in_layer = true;
+    return true;
+}
+
+/** @brief Backend layer_end: the region goes into the layer, as a host uploads it. */
+static void layer_end_cb(void* ctx)
+{
+    TestCtx* t = ctx;
+    t->in_layer = false;
+    for (int row = 0; row < t->sh; row++)
+        memcpy(&t->layer[(t->sy - t->ly + row) * t->lw + t->sx - t->lx], &t->staging[row * t->sw], (size_t)t->sw * 4U);
+}
+
+/**
+ * @brief Installs the test backend, with or without the layer.
+ *
+ * @param[in] with_layer  Whether to provide layer_begin / layer_end.
+ */
+static void install(bool with_layer)
+{
+    memset(&g_be, 0, sizeof(g_be));
+    g_be.fill_rect = fill_cb;
+    g_be.copy_rect = copy_cb;
+    g_be.blend_rect = blend_cb;
+    g_be.layer_resize = with_layer ? layer_resize_cb : NULL;
+    g_be.layer_begin = with_layer ? layer_begin_cb : NULL;
+    g_be.layer_end = with_layer ? layer_end_cb : NULL;
+    g_be.ctx = &g_ctx;
+    embedded_renderer_set_backend(&g_be); /* also forces the next commit to repaint in full */
+}
+
+/** @brief Creates a sized View with a background colour and appends it to @p parent (when given). */
+static ERNode* view(ERNode* parent, int w, int h, uint32_t bg)
+{
+    ERNode* n = er_node_create(ER_NODE_VIEW);
+    ERProps p;
+    er_props_default(&p);
+    p.width = (int16_t)w;
+    p.height = (int16_t)h;
+    p.background_color = bg;
+    er_node_set_props(n, &p);
+    if (parent)
+        er_tree_append_child(parent, n);
+    return n;
+}
+
+/** @brief Reports a failed expectation. */
+static void expect(bool ok, const char* what, const char* detail)
+{
+    if (!ok)
+    {
+        fprintf(stderr, "FAIL %s: %s\n", what, detail);
+        g_failures++;
+    }
+}
+
+/**
+ * @brief Composites the framebuffer and the layer as a host would, then compares the result with a full
+ *        repaint of the same scene without a layer, pixel for pixel. Leaves the layer backend installed.
+ *
+ * @param[in] what     Name of the check, for the failure message.
+ * @param[in] layered  Whether the scene is expected to be layered.
+ */
+static void check(const char* what, bool layered)
+{
+    static uint32_t shown[FB_W * FB_H];
+    memcpy(shown, g_ctx.fb, sizeof(shown));
+    ERScrollLayer l;
+    const bool active = er_scroll_layer_get(&l);
+    expect(active == layered, what, layered ? "expected a layer" : "expected no layer");
+    if (active)
+        for (int row = 0; row < l.view.h; row++)
+            memcpy(&shown[(l.view.y + row) * FB_W + l.view.x],
+                   &g_ctx.layer[(l.src_y + row) * g_ctx.lw + l.src_x],
+                   (size_t)l.view.w * 4U);
+
+    memset(g_ctx.fb, 0, sizeof(g_ctx.fb));
+    install(false);
+    er_commit(); /* full repaint without the layer: the reference */
+    int diffs = 0, first = -1;
+    for (int i = 0; i < FB_W * FB_H; i++)
+        if (shown[i] != g_ctx.fb[i] && diffs++ == 0)
+            first = i;
+    if (diffs)
+    {
+        fprintf(stderr,
+                "FAIL %s: %d pixels differ from a full repaint, first at (%d,%d) %08x vs %08x\n",
+                what,
+                diffs,
+                first % FB_W,
+                first / FB_W,
+                shown[first],
+                g_ctx.fb[first]);
+        g_failures++;
+    }
+    install(true);
+    er_commit(); /* back in the layer, from scratch */
+}
+
+/** @brief Scrolls to @p y and commits. */
+static void scroll_to(ERNode* sv, float y)
+{
+    er_scroll_view_set_offset(sv, 0.0f, y);
+    er_commit();
+}
+
+int main(void)
+{
+    install(true);
+    er_reset();
+
+    /* An opaque root and a ScrollView of striped rows, some with translucent inner boxes. */
+    ERNode* root = view(NULL, FB_W, FB_H, 0xFF102030U);
+    ERProps sp;
+    er_props_default(&sp);
+    sp.position = ER_POS_ABSOLUTE;
+    sp.left = 20;
+    sp.top = 30;
+    sp.width = 110;
+    sp.height = 100;
+    ERNode* sv = er_node_create(ER_NODE_SCROLL_VIEW);
+    er_node_set_props(sv, &sp);
+    er_tree_append_child(root, sv);
+    ERNode* content = view(sv, 110, ROWS * 12, 0);
+    ERNode* rows[ROWS];
+    for (int i = 0; i < ROWS; i++)
+    {
+        rows[i] = view(content, 110, 12, 0xFF000000U | (uint32_t)(i * 2654435761U >> 8));
+        if (i % 3 == 0)
+            view(rows[i], 30 + i, 6, 0x80FFFFFFU);
+    }
+    /* Across the 128-row edge between two painted regions: a shadow, a gradient, a scale and opacity, whose
+     * blends must resolve inside each region. */
+    ERProps dp;
+    er_props_default(&dp);
+    dp.position = ER_POS_ABSOLUTE;
+    dp.left = 20;
+    dp.top = -20;
+    dp.width = 60;
+    dp.height = 62;
+    dp.opacity = 200;
+    dp.shadow_opacity = 0.6f;
+    dp.shadow_radius = 6;
+    dp.shadow_offset_y = 3.0f;
+    dp.transform_scale_x = 1.1f;
+    dp.transform_scale_y = 1.1f;
+    dp.gradient_type = ER_GRADIENT_LINEAR;
+    dp.gradient_stop_count = 2;
+    dp.gradient_stops[0].color = 0xFF20A0E0U;
+    dp.gradient_stops[0].position = 0.0f;
+    dp.gradient_stops[1].color = 0x80E04020U;
+    dp.gradient_stops[1].position = 1.0f;
+    ERNode* deco = er_node_create(ER_NODE_VIEW);
+    er_node_set_props(deco, &dp);
+    er_tree_append_child(rows[9], deco);
+    er_tree_set_root(root);
+    er_commit();
+    check("first frame", true);
+    while (er_scroll_layer_prefetch(256) > 0)
+    {
+    }
+    scroll_to(sv, 70.0f);
+    check("decorations across a region edge", true);
+
+    /* Steps down and up, each against a full repaint. */
+    const float steps[] = {5.0f, 17.0f, 40.5f, 39.0f, 0.0f, 99.0f, 250.0f, 260.0f};
+    for (size_t i = 0; i < sizeof steps / sizeof steps[0]; i++)
+    {
+        scroll_to(sv, steps[i]);
+        char what[64];
+        snprintf(what, sizeof what, "step to %.1f", (double)steps[i]);
+        check(what, true);
+    }
+
+    /* Once the whole layer is painted, a scroll paints nothing. */
+    scroll_to(sv, 0.0f);
+    while (er_scroll_layer_prefetch(256) > 0)
+    {
+    }
+    g_ctx.painted_px = 0;
+    for (int i = 1; i <= 12; i++)
+        scroll_to(sv, (float)(i * 19));
+    expect(g_ctx.painted_px == 0, "scroll after prefetch", "a scroll painted pixels");
+    check("chain of scrolls after prefetch", true);
+
+    /* Without prefetch the scroll paints the bands it reaches. */
+    for (int i = 1; i <= 12; i++)
+        scroll_to(sv, (float)(i * 21));
+    check("chain of scrolls without prefetch", true);
+
+    /* Changes in the content repaint in the layer, including rows out of view. */
+    ERProps rp;
+    er_props_default(&rp);
+    rp.width = 110;
+    rp.height = 12;
+    rp.background_color = 0xFFFFFFFFU;
+    er_node_set_props(rows[10], &rp);
+    er_node_set_props(rows[27], &rp);
+    scroll_to(sv, 80.0f);
+    check("row changes with a scroll", true);
+    er_node_set_props(rows[2], &rp);
+    er_commit();
+    while (er_scroll_layer_prefetch(256) > 0)
+    {
+    }
+    er_node_set_props(rows[25], &rp);
+    er_commit();
+    scroll_to(sv, 230.0f);
+    check("change out of view, then scroll to it", true);
+
+    /* A layout shift far from the viewport marks bands stale instead of painting them: what is shown later,
+     * after prefetch or by scrolling there, is still exact. */
+    scroll_to(sv, 800.0f);
+    while (er_scroll_layer_prefetch(256) > 0)
+    {
+    }
+    rp.height = 30;
+    er_node_set_props(rows[0], &rp);
+    er_commit();
+    check("layout shift above the viewport", true);
+    rp.height = 18;
+    er_node_set_props(rows[0], &rp);
+    er_commit();
+    scroll_to(sv, 0.0f);
+    check("scroll into a shifted, stale part", true);
+    rp.height = 12;
+    er_node_set_props(rows[0], &rp);
+    scroll_to(sv, 800.0f);
+    er_commit();
+    while (er_scroll_layer_prefetch(256) > 0)
+    {
+    }
+    scroll_to(sv, 10.0f);
+    check("prefetch over a shifted, stale part", true);
+
+    /* Removing and adding rows moves the ones below and changes the layer height. */
+    er_tree_remove_child(content, rows[5]);
+    er_node_destroy(rows[5]);
+    er_commit();
+    scroll_to(sv, 60.0f);
+    check("row removed", true);
+    for (int i = 0; i < 6; i++)
+        view(content, 110, 12, 0xFF406080U + (uint32_t)i * 0x10U);
+    ERProps cp;
+    er_props_default(&cp);
+    cp.width = 110;
+    cp.height = (ROWS + 5) * 12;
+    er_node_set_props(content, &cp);
+    er_commit();
+    scroll_to(sv, 400.0f);
+    check("rows added", true);
+
+    /* A horizontal ScrollView inside the content repaints its row in the layer when it scrolls. */
+    ERProps hp;
+    er_props_default(&hp);
+    hp.width = 110;
+    hp.height = 20;
+    hp.flex_direction = ER_FLEX_ROW;
+    ERNode* hsv = er_node_create(ER_NODE_SCROLL_VIEW);
+    er_node_set_props(hsv, &hp);
+    er_tree_insert_before(content, hsv, rows[12]);
+    for (int i = 0; i < 8; i++)
+        view(hsv, 30, 20, 0xFF000000U | (uint32_t)((i + 7) * 2654435761U >> 8));
+    er_commit();
+    scroll_to(sv, 100.0f);
+    er_scroll_view_set_offset(hsv, 33.0f, 0.0f);
+    er_commit();
+    check("nested horizontal scroll", true);
+
+    /* An overlay over the viewport ends the layer; removing it brings the layer back. */
+    ERNode* overlay = er_node_create(ER_NODE_VIEW);
+    ERProps op;
+    er_props_default(&op);
+    op.position = ER_POS_ABSOLUTE;
+    op.left = 60;
+    op.top = 22;
+    op.width = 40;
+    op.height = 16;
+    op.background_color = 0xC0FF8000U;
+    er_node_set_props(overlay, &op);
+    er_tree_append_child(root, overlay);
+    er_commit();
+    scroll_to(sv, 120.0f);
+    check("overlay ends the layer", false);
+    er_tree_remove_child(root, overlay);
+    er_node_destroy(overlay);
+    er_commit();
+    scroll_to(sv, 140.0f);
+    check("overlay gone", true);
+
+    /* Turning the layer off repaints the viewport on the framebuffer. */
+    er_scroll_layer_enable(false);
+    er_commit();
+    check("layer disabled", false);
+    er_scroll_layer_enable(true);
+    er_commit();
+
+    /* A backend that cannot hold the layer keeps the ScrollView on the framebuffer. */
+    cp.height = 1300 * 12;
+    er_node_set_props(content, &cp);
+    er_commit();
+    scroll_to(sv, 4000.0f);
+    check("layer too tall for the backend", false);
+
+    if (g_failures)
+        return EXIT_FAILURE;
+    printf("scroll layer: all checks passed\n");
+    return EXIT_SUCCESS;
+}
