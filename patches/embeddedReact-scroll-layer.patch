+        if (s_in_layer[i])
+            s_nodes[i].has_last_paint = false; /* layer-space footprints, never painted on the framebuffer */
+    }
+    memset(s_in_layer, 0, sizeof(s_in_layer));
+    s_layer_tag = ER_INVALID_TAG;
+    er_damage_set_clear(&s_layer_removed);
+    er_damage_set_add(&s_removed_set, s_layer_view.x, s_layer_view.y, s_layer_view.w, s_layer_view.h);
+    ERNode* root = er_get_node(s_root_tag);
+    if (root)
+        root->dirty = true; /* the vacated viewport repaints whatever is there now */
+    if (s && !s->subtree_hidden && s->in_use)
+        er_mark_dirty_upward(s);
+}
+
+/**
+ * @brief Moves a ScrollView into the layer; s_in_layer must hold its descendants.
+ *
+ * @return false when the backend could not provide the layer.
+ */
+static bool layer_enter(ERNode* s, const ERRect* rect, const ERRect* view, uint32_t underlay)
+{
+    s_layer_rect = *rect;
+    bool kept;
+    if (!layer_resize(&kept))
+    {
+        s_layer_refused_tag = s->tag;
+        s_layer_refused_rect = *rect;
+        memset(s_in_layer, 0, sizeof(s_in_layer));
+        return false;
+    }
+    s_layer_entries++;
+    s_layer_tag = s->tag;
+    s_layer_view = *view;
+    s_layer_underlay = underlay;
+    s_layer_sy = (int)s->scroll_offset_y;
+    memset(s_layer_valid, 0, sizeof(s_layer_valid));
+    er_damage_set_clear(&s_layer_removed);
+    for (int i = 0; i < (int)ERUI_MAX_NODES; i++)
+    {
+        if (s_in_layer[i])
+            s_nodes[i].has_last_paint = false; /* their pixels are on the framebuffer, not in the layer */
+    }
+    return true;
+}
+
+/**
+ * @brief Settles which ScrollView is layered for this commit, after layout and before the damage pre-pass.
+ *
+ * Keeps the current one while it qualifies at the same position and width (a new height keeps the rows
+ * above it); otherwise leaves it, then layers the largest qualifying ScrollView, if any.
+ */
+static void layer_update(void)
+{
+    ERRect rect, view;
+    uint32_t underlay = 0U;
+    const EmbeddedRenderBackend* b = er_backend();
+    const bool allowed =
+        s_layer_enabled && b && b->layer_resize && b->layer_begin && b->layer_end && b->band_height == 0;
+    ERNode* s = er_get_node(s_layer_tag);
+    if (s)
+    {
+        if (allowed && layer_candidate(s, &rect, &view, &underlay) && rect.x == s_layer_rect.x
+            && rect.y == s_layer_rect.y && rect.w == s_layer_rect.w && underlay == s_layer_underlay)
+        {
+            s_layer_view = view;
+            if (rect.h == s_layer_rect.h)
+                return;
+            /* Bands past the shorter height were never painted for this one, or not lately. */
+            const int same = (rect.h < s_layer_rect.h ? rect.h : s_layer_rect.h) / ER_LAYER_BAND;
+            s_layer_rect = rect;
+            bool kept;
+            if (layer_resize(&kept))
+            {
+                for (int band = kept ? same : 0; band < ER_LAYER_BANDS; band++)
+                    s_layer_valid[band] = false;
+                return;
+            }
+        }
+        layer_leave();
+    }
+    if (!allowed)
+        return;
+
+    ERNode* best = NULL;
+    long best_area = 0;
+    for (uint16_t tag = 0U; tag < (uint16_t)ERUI_MAX_NODES; tag++)
+    {
+        ERNode* n = er_get_node(tag);
+        if (!n || (n->type != ER_NODE_SCROLL_VIEW && n->type != ER_NODE_FLAT_LIST))
+            continue;
+        if (!layer_candidate(n, &rect, &view, &underlay))
+            continue;
+        if (tag == s_layer_refused_tag && rect.x == s_layer_refused_rect.x && rect.y == s_layer_refused_rect.y
+            && rect.w == s_layer_refused_rect.w && rect.h == s_layer_refused_rect.h)
+            continue;
+        if ((long)view.w * view.h > best_area)
+        {
+            best = n;
+            best_area = (long)view.w * view.h;
+        }
+    }
+    if (best && layer_candidate(best, &rect, &view, &underlay))
+        layer_enter(best, &rect, &view, underlay);
+    else
+        memset(s_in_layer, 0, sizeof(s_in_layer));
+}
+
+/**
+ * @brief Paints one layer rect from scratch: the underlay, then the ScrollView's children over it.
+ *
+ * @param[in] x,y,w,h  Rect in layer space; clipped to the layer.
+ */
+static void render_layer_rect(int x, int y, int w, int h)
+{
+    if (!rect_intersect(&x, &y, &w, &h, s_layer_rect.x, s_layer_rect.y, s_layer_rect.w, s_layer_rect.h))
+        return;
+    const EmbeddedRenderBackend* b = er_backend();
+    const ERNode* s = er_get_node(s_layer_tag);
+    uint16_t child_tags[ERUI_MAX_NODES];
+    const int child_count = er_collect_children(s, child_tags, ERUI_MAX_NODES);
+    er_sort_children_by_z_index(child_tags, child_count);
+    /* Every pixel of a region is painted from scratch inside its clip, so the backend never needs the
+     * layer's earlier pixels: regions of at most ER_LAYER_BAND rows fit a small staging buffer. */
+    for (int ry = y; ry < y + h; ry += ER_LAYER_BAND)
+    {
+        const int rh = (y + h - ry) < ER_LAYER_BAND ? (y + h - ry) : ER_LAYER_BAND;
+        if (!b->layer_begin(x, ry, w, rh, b->ctx))
+            continue;
+        er_push_clip_rect(x, ry, w, rh);
+        er_blit_fill(s_layer_underlay, x, ry, w, rh);
+        for (int i = 0; i < child_count; i++)
+        {
+            ERNode* child = er_get_node(child_tags[i]);
+            if (child)
+                render_tree(child, true, false, 0, 0);
+        }
+        er_pop_clip_rect();
+        b->layer_end(b->ctx);
+    }
+}
+
+/** @brief Paints band @p b in full and records it as current. */
+static void render_layer_band(int b)
+{
+    render_layer_rect(s_layer_rect.x, s_layer_rect.y + b * ER_LAYER_BAND, s_layer_rect.w, ER_LAYER_BAND);
+    s_layer_valid[b] = true;
+}
+
+/** @brief Takes the layered ScrollView's current whole-pixel offset as the one this commit shows. */
+static void layer_sync_offset(void)
+{
+    const int sy = (int)er_get_node(s_layer_tag)->scroll_offset_y;
+    if (sy != s_layer_sy)
+        s_layer_dir = sy > s_layer_sy ? 1 : -1;
+    s_layer_sy = sy;
+}
+
+/** @brief Marks the bands rows [y, y + h) of layer space touch as stale. */
+static void layer_invalidate(int y, int h)
+{
+    int b0 = (y - s_layer_rect.y) / ER_LAYER_BAND;
+    int b1 = (y + h - 1 - s_layer_rect.y) / ER_LAYER_BAND;
+    b0 = b0 < 0 ? 0 : b0;
+    b1 = b1 >= ER_LAYER_BANDS ? ER_LAYER_BANDS - 1 : b1;
+    for (int b = b0; b <= b1; b++)
+    {
+        s_layer_valid[b] = false;
+        s_layer_touched[b] = s_commit_seq;
+    }
+}
+
+/** @brief First and last band the viewport shows at the offset of the last commit. */
+static void layer_visible_bands(int* first, int* last)
+{
+    const int top = s_layer_view.y + s_layer_sy - s_layer_rect.y;
+    *first = top / ER_LAYER_BAND;
+    *last = (top + s_layer_view.h - 1) / ER_LAYER_BAND;
+    if (*last >= layer_band_count())
+        *last = layer_band_count() - 1;
+}
+
+/**
+ * @brief The layer half of a commit: brings the bands the viewport shows up to date and repaints the
+ *        layer's damage.
+ *
+ * @param[in] dmg  Layer damage from the pre-pass.
+ * @param[in] all  Whether the whole layer is stale (a full repaint, or a change the pre-pass cannot bound).
+ */
+static void layer_paint(const ERDamageSet* dmg, bool all)
+{
+    layer_sync_offset();
+    if (all)
+        memset(s_layer_valid, 0, sizeof(s_layer_valid));
+    s_layer_pass = true;
+    int first, last;
+    layer_visible_bands(&first, &last);
+    /* Each run of stale bands is one rect, so what the viewport shows is painted in as few passes as a
+     * framebuffer repaint would use. */
+    for (int b = first; b <= last; b++)
+    {
+        if (s_layer_valid[b])
+            continue;
+        int end = b;
+        while (end < last && !s_layer_valid[end + 1])
+            end++;
+        render_layer_rect(s_layer_rect.x, s_layer_rect.y + b * ER_LAYER_BAND, s_layer_rect.w,
+                          (end - b + 1) * ER_LAYER_BAND);
+        for (; b <= end; b++)
+            s_layer_valid[b] = true;
+    }
+    for (uint8_t i = 0U; i < dmg->count; i++)
+        render_layer_rect(dmg->r[i].x, dmg->r[i].y, dmg->r[i].w, dmg->r[i].h);
+    s_layer_pass = false;
+}
+
+bool er_scroll_layer_get(ERScrollLayer* out)
+{
+    if (s_layer_tag == ER_INVALID_TAG)
+        return false;
+    out->view = s_layer_view;
+    out->src_x = s_layer_view.x - s_layer_rect.x;
+    out->src_y = s_layer_view.y - s_layer_rect.y + s_layer_sy;
+    out->width = s_layer_rect.w;
+    out->height = s_layer_rect.h;
+    out->entries = s_layer_entries;
+    return true;
+}
+
+void er_scroll_layer_enable(bool enabled)
+{
+    s_layer_enabled = enabled;
+}
+
+int er_scroll_layer_prefetch(int max_rows)
+{
+    if (s_layer_tag == ER_INVALID_TAG || max_rows <= 0)
+        return 0;
+    int first, last;
+    layer_visible_bands(&first, &last);
+    const int count = layer_band_count();
+    int rows = 0;
+    s_layer_pass = true;
+    for (int d = 1; rows < max_rows && (first - d >= 0 || last + d < count); d++)
+    {
+        const int ahead = s_layer_dir > 0 ? last + d : first - d;
+        const int behind = s_layer_dir > 0 ? first - d : last + d;
+        const int order[2] = {ahead, behind};
+        for (int i = 0; i < 2 && rows < max_rows; i++)
+        {
+            const int b = order[i];
+            /* A band marked stale again within the last few commits is still changing (an animation off
+             * screen): painting it now would be wasted. It is painted once quiet, or when it shows. */
+            if (b < 0 || b >= count || s_layer_valid[b] || s_commit_seq - s_layer_touched[b] < ER_LAYER_QUIET)
+                continue;
+            render_layer_band(b);
+            rows += ER_LAYER_BAND;
+        }
+    }
+    s_layer_pass = false;
+    return rows;
+}
+
+/**
+ * @brief Adds one node's damage to the commit's set: where it is now and where it was painted, when either
+ *        changed.
+ *
+ * @param[in,out] n                        Node to measure.
+ * @param[in,out] dmg                      Damage set of the space the node paints in.
+ * @param[in]     rb_x0,rb_y0,rb_x1,rb_y1  Bounds of that space, which the damage is clamped to.
+ * @param[out]    footprint                When not NULL, receives the footprint a paint would record for a
+ *                                         changed plain node (no transform on it or above it, visible inside
+ *                                         its clippers); w is -1 otherwise.
+ *
+ * @return false when the change cannot be bounded and the whole space must be repainted.
+ */
+static bool
+damage_node(ERNode* n, ERDamageSet* dmg, int rb_x0, int rb_y0, int rb_x1, int rb_y1, ERRect* footprint)
+{
+    if (footprint)
+        footprint->w = -1;
+    if (n->subtree_hidden && !(n->type == ER_NODE_MODAL && n->modal_scrim_shown))
+        return true;
+    if (n->overflow_toggled)
+    {
+        /* Under a transformed ancestor the subtree bounds below are source-space, like every
+         * other measurement of this node — the ancestor's blit is what puts the toggled
+         * region on screen, and its AABB already covers the whole subtree. */
+        ERNode* const ov_cap = capturing_transform_ancestor(n);
+        if (ov_cap && escalate_damage_to_capture(n, ov_cap, dmg, false, rb_x0, rb_y0, rb_x1, rb_y1))
+            return true;
+        /* This node clipped or unclipped its children since the last commit. Its own box is
+         * damaged below like any visual change; the half the box cannot express is the region
+         * its descendants painted (or are about to paint) outside it, which is this — the
+         * post-layout subtree bounds. The pre-change bounds came in through the vacated set at
+         * the top, so the union of the two covers the toggle in either direction.
+         *
+         * Reported as well as damaged: the descendants out there are not necessarily
+         * source-dirty, and on the clipping side what repaints the region is an ancestor's
+         * background, so render_tree's accumulator would never contribute it. */
+        int sx, sy, sw, sh;
+        if (!node_subtree_screen_rect(n, &sx, &sy, &sw, &sh))
+            return false; /* transform we cannot bound: repaint everything */
+        clip_rect_to_clippers(n, &sx, &sy, &sw, &sh);
+        add_damage(dmg, sx, sy, sw, sh, rb_x0, rb_y0, rb_x1, rb_y1);
+        report_repaint_clamped(sx, sy, sw, sh, rb_x0, rb_y0, rb_x1, rb_y1);
+    }
+    /* Asked before the rect is measured, because the answer must not depend on which helper
+     * manages to measure it: the backdrop covers the root either way. Both branches below
+     * hand a changed scrim modal straight to modal_scrim_damage(). */
+    const bool scrim_modal = (n->type == ER_NODE_MODAL && (n->modal_visible || n->modal_scrim_shown));
+    int rx, ry, rw, rh;
+    if (!node_screen_rect(n, &rx, &ry, &rw, &rh))
+    {
+        /* Complex transform (scale/rotate). Bound the damage to the node's transformed AABB —
+         * current box plus where it was painted last commit, so a shrinking pulse erases its
+         * trail — instead of forcing a full-screen repaint.
+         */
+        NodeTransformDamage td = {0};
+        if (node_transform_damage(n, &td))
+        {
+            const bool moved = n->has_last_paint
+                               && (td.fx != (int)n->last_paint_rect.x || td.fy != (int)n->last_paint_rect.y
+                                   || td.fw != (int)n->last_paint_rect.w || td.fh != (int)n->last_paint_rect.h
+                                   || spans_paint_window(td.fx, td.fy, td.fw, td.fh));
+            /* The third way this node's pixels can move: an ANCESTOR gained or lost a transform,
+             * which hands the capture to a different node and flips this one between its AABB and
+             * its raw box (issue #139). It leaves the node clean and its layout box where it was,
+             * so neither test above sees it — and `moved` never will, because the prediction that
+             * has to be checked against is the STALE flag's, which by definition still agrees with
+             * last_paint_rect. `hedge` is exactly the state of not knowing which footprint the
+             * paint will use, so it is the state in which a change above has to be listened for;
+             * a node whose footprint is certain stays as idle as it was. */
+            if (n->source_dirty || moved || (td.hedge && source_dirty_above(n)))
+            {
+                /* Asked before the ancestor-capture escalation below, for the same reason the
+                 * translate-only branch asks it before its own: the scrim covers the root
+                 * regardless of what any ancestor does to this node's pixels. */
+                if (scrim_modal)
+                {
+                    modal_scrim_damage(n, dmg, rb_x0, rb_y0, rb_x1, rb_y1);
+                    return true;
+                }
+                /* Refused the scratch because an ancestor holds it: this node painted into
+                 * that ancestor's capture in source space, so td measures a region its pixels
+                 * never reach. The ancestor's AABB is where they actually land. */
+                ERNode* const cap = capturing_transform_ancestor(n);
+                if (cap
+                    && escalate_damage_to_capture(n, cap, dmg, !n->source_dirty, rb_x0, rb_y0, rb_x1, rb_y1))
+                    return true;
+                int nx = td.fx, ny = td.fy, nw = td.fw, nh = td.fh;
+                clip_rect_to_clippers(n, &nx, &ny, &nw, &nh);
+                add_damage(dmg, nx, ny, nw, nh, rb_x0, rb_y0, rb_x1, rb_y1); /* new footprint */
+                if (!n->source_dirty)
+                    report_repaint_clamped(nx, ny, nw, nh, rb_x0, rb_y0, rb_x1, rb_y1);
+                if (td.hedge)
+                {
+                    /* Which footprint the paint lands on rests on the ancestor chain, not on
+                     * anything measurable here, so damage the other candidate too rather than
+                     * risk scissoring the node's own paint away. */
+                    int hx = td.hx, hy = td.hy, hw = td.hw, hh = td.hh;
+                    clip_rect_to_clippers(n, &hx, &hy, &hw, &hh);
+                    add_damage(dmg, hx, hy, hw, hh, rb_x0, rb_y0, rb_x1, rb_y1);
+                    if (!n->source_dirty)
+                        report_repaint_clamped(hx, hy, hw, hh, rb_x0, rb_y0, rb_x1, rb_y1);
+                }
+                if (n->has_last_paint)
+                {
+                    int ox = (int)n->last_paint_rect.x, oy = (int)n->last_paint_rect.y,
+                        ow = (int)n->last_paint_rect.w, oh = (int)n->last_paint_rect.h;
+                    clip_rect_to_clippers(n, &ox, &oy, &ow, &oh);
+                    add_damage(dmg, ox, oy, ow, oh, rb_x0, rb_y0, rb_x1, rb_y1); /* old (erase trail) */
+                    report_repaint_clamped(ox, oy, ow, oh, rb_x0, rb_y0, rb_x1, rb_y1);
+                }
+            }
+            return true;
+        }
+        /*
+         * Could not bound it (a transform that projects to nothing): only forces a full repaint
+         * if actually changing. An oversized node no longer lands here — node_transform_damage()
+         * settles it on size and returns the raw box; neither does a spinning ActivityIndicator,
+         * which node_screen_rect() bounds at the box+translate it actually paints at.
+         * TODO: A moved-but-not-source_dirty node here (e.g. a 3D-transformed node shifted by reflow) is still
+         * missed — that needs the 3D AABB path ().
+         */
+        if (n->source_dirty)
+        {
+            /* Bounded after all, and by the only rect that was ever right for it: a modal that
+             * cannot be measured still scrims exactly the root. Cheaper than the full-repaint
+             * fallback below, and unlike it, retires the scrim flag. */
+            if (scrim_modal)
+            {
+                modal_scrim_damage(n, dmg, rb_x0, rb_y0, rb_x1, rb_y1);
+                return true;
+            }
+            /* Inside an ancestor's capture this is bounded after all: whatever the node's own
+             * transform does, it does it in source space and reaches the screen only through
+             * the ancestor's blit. Beats a full-screen repaint per animated frame. */
+            ERNode* const cap = capturing_transform_ancestor(n);
+            if (cap && escalate_damage_to_capture(n, cap, dmg, false, rb_x0, rb_y0, rb_x1, rb_y1))
+                return true;
+            return false;
+        }
+        return true;
+    }
+    const int box_rx = rx, box_ry = ry; /* the layout box, before any arc inflation */
+    /* Measure the node by its painted footprint — the box plus the arc knob's reach past it and
+     * the shadow's bleed around it — which is what last_paint_rect records, so a steady node is
+     * not read as "moved" every commit. Both are folded in HERE, ahead of the comparison, and
+     * not again below: the new footprint and the recorded trail have to be the same measurement
+     * or they can never agree. */
+    expand_for_arc(n, &rx, &ry, &rw, &rh);
+#if ERUI_SHADOWS
+    expand_for_shadow(n, &rx, &ry, &rw, &rh);
+#endif
+    /* Clipped as the record is, or a footprint past the clip would never match it. */
+    clip_rect_axis(&rx, &rw);
+    clip_rect_axis(&ry, &rh);
+    const bool moved = n->has_last_paint
+                       && (rx != (int)n->last_paint_rect.x || ry != (int)n->last_paint_rect.y
+                           || rw != (int)n->last_paint_rect.w || rh != (int)n->last_paint_rect.h
+                           || spans_paint_window(rx, ry, rw, rh));
+    if (!n->source_dirty && !moved)
+        return true; /* unchanged and in place: contributes nothing to the damage */
+    if (scrim_modal)
+    {
+        modal_scrim_damage(n, dmg, rb_x0, rb_y0, rb_x1, rb_y1);
+        return true;
+    }
+    /* Everything below measures this node in plain layout-minus-scroll space. Under a
+     * transformed ancestor that space is the ancestor's CAPTURE, not the screen: the node's
+     * pixels are inverse-mapped out at the ancestor's transformed AABB, so that AABB — and
+     * not any rect derived from the node's own box — is what has to be repainted.
+     * (Asked after the Modal case, whose scrim covers the root regardless of any ancestor.) */
+    {
+        ERNode* const cap = capturing_transform_ancestor(n);
+        if (cap && escalate_damage_to_capture(n, cap, dmg, !n->source_dirty, rb_x0, rb_y0, rb_x1, rb_y1))
+            return true;
+    }
+    if (footprint)
+        *footprint = (ERRect){rx, ry, rw, rh};
+    if ((n->type == ER_NODE_VECTOR || n->type == ER_NODE_ARC) && n->vec_has_dirty && !moved)
+    {
+        /* Sub-region vector update: damage only the app-supplied changed rect (node-local →
+         * screen), not the whole box. The caller's rect already covers old+new content, so the
+         * full last_paint_rect is intentionally NOT added (it would balloon back to the box). */
+        int vox, voy;
+        vec_dirty_offset(n, &vox, &voy);
+        add_damage(dmg,
+                   box_rx + vox + (int)n->vec_dirty_x,
+                   box_ry + voy + (int)n->vec_dirty_y,
+                   (int)n->vec_dirty_w,
+                   (int)n->vec_dirty_h,
+                   rb_x0,
+                   rb_y0,
+                   rb_x1,
+                   rb_y1);
+        return true;
+    }
+    /* Clip both contributions to any clipping ancestor (ScrollView / overflow:hidden) so a scrolled
+     * child's damage can't reach outside the list and pull a sibling (e.g. a title above) into the
+     * repaint, where it would be cleared but not restored for a frame. */
+    int nx = rx, ny = ry, nw = rw, nh = rh;
+    clip_rect_to_clippers(n, &nx, &ny, &nw, &nh);
+    add_damage(dmg, nx, ny, nw, nh, rb_x0, rb_y0, rb_x1, rb_y1); /* new position */
+    /* A node here that is NOT source_dirty is contributing purely because it MOVED, and
+     * render_tree's accumulator only ever unions source-dirty nodes — so it reports itself,
+     * exactly like the vacated footprints above. Without this a pure reflow repaints the
+     * framebuffer correctly and then tells a partial-update host that nothing changed. */
+    if (!n->source_dirty)
+        report_repaint_clamped(nx, ny, nw, nh, rb_x0, rb_y0, rb_x1, rb_y1);
+    if (n->has_last_paint)
+    {
+        int ox = (int)n->last_paint_rect.x, oy = (int)n->last_paint_rect.y, ow = (int)n->last_paint_rect.w,
+            oh = (int)n->last_paint_rect.h;
+        clip_rect_to_clippers(n, &ox, &oy, &ow, &oh);
+        add_damage(dmg, ox, oy, ow, oh, rb_x0, rb_y0, rb_x1, rb_y1); /* old position (erase trail) */
+        /* Reported unconditionally, unlike the new position: render_tree's accumulator only
