+/** @brief Points fill/copy/blend back at the framebuffer. */
+static void target_framebuffer(SoftCtx* c)
+{
+    c->dst = c->fb;
+    c->dst_w = c->fb_w;
+    c->dst_h = c->fb_h;
+    c->dst_x = 0;
+    c->dst_y = 0;
+}
+
+/** @brief Backend layer_resize: forwards the size to the host, within the allowed rows. */
+static bool layer_resize_cb(int x0, int y0, int w, int h, bool* kept, void* ctx)
+{
+    SoftCtx* c = ctx;
+    if (w <= 0 || h <= 0 || h > c->layer_max || !c->host.resize(w, h, kept, c->host.ctx))
+        return false;
+    *kept = *kept && x0 == c->layer_x && y0 == c->layer_y;
+    c->layer_x = x0;
+    c->layer_y = y0;
+    return true;
+}
+
+/** @brief Backend layer_begin: sends fill/copy/blend to the staging buffer, grown to the region. */
+static bool layer_begin_cb(int x, int y, int w, int h, void* ctx)
+{
+    SoftCtx* c = ctx;
+    const size_t px = (size_t)w * (size_t)h;
+    if (px > c->staging_px)
+    {
+        uint32_t* ns = realloc(c->staging, px * sizeof(uint32_t));
+        if (!ns)
+            return false;
+        c->staging = ns;
+        c->staging_px = px;
+    }
+    c->dst = c->staging;
+    c->dst_w = w;
+    c->dst_h = h;
+    c->dst_x = x;
+    c->dst_y = y;
+    return true;
+}
+
+/** @brief Backend layer_end: hands the painted region to the host, then writes to the framebuffer again. */
+static void layer_end_cb(void* ctx)
+{
+    SoftCtx* c = ctx;
+    c->host.region(c->staging, c->dst_x - c->layer_x, c->dst_y - c->layer_y, c->dst_w, c->dst_h, c->host.ctx);
+    target_framebuffer(c);
+}
